{
  "name": "job-screen-assistant",
  "version": "0.1.8",
  "private": true,
  "description": "独立的校园招聘岗位收集与筛选浏览器插件",
  "scripts": {
    "test": "node --test tests/jobs.test.cjs tests/jobs-routes.test.cjs tests/jobs-major-preferences.test.cjs tests/jobs-degree-context.test.cjs",
    "test:extension": "node tests/jobs.browser.cjs",
    "test:collection": "node tests/jobs-collection.browser.cjs",
    "test:recognition": "node tests/jobs-recognition.browser.cjs",
    "test:multisite": "node tests/jobs-multisite.browser.cjs",
    "test:access": "node tests/jobs-access.browser.cjs",
    "test:boundaries": "node tests/jobs-boundaries.browser.cjs",
    "test:details": "node tests/jobs-details.browser.cjs",
    "test:identity": "node tests/jobs-identity.browser.cjs",
    "test:widget": "node tests/jobs-widget.browser.cjs",
    "test:compatibility": "node tests/jobs-compatibility.browser.cjs",
    "test:spa": "node tests/jobs-spa.browser.cjs",
    "test:image-links": "node tests/jobs-image-links.browser.cjs",
    "test:semantic-cards": "node tests/jobs-semantic-cards.browser.cjs",
    "test:split-table": "node tests/jobs-split-table.browser.cjs",
    "package": "python tools/package_extension.py"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
